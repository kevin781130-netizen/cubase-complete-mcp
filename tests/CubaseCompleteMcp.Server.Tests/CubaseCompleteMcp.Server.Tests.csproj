    <IsTestProject>true</IsTestProject>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Description>MCP tools/list schema and serialized-call contract tests for the stdio server.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CubaseCompleteMcp.Core\CubaseCompleteMcp.Core.csproj" />
    <ProjectReference Include="..\..\src\CubaseCompleteMcp.Server\CubaseCompleteMcp.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../DawprojectSchema/*.xsd" Link="DAWprojectSchema/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../scripts/xclip_foley_action_provider.py" Link="providers/xclip_foley_action_provider.py" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../scripts/cutpilot_foley_scene_provider.py" Link="providers/cutpilot_foley_scene_provider.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
